package vmm:host;

interface api {
    record cpuid {
        func-val: u32,
        index: option<u32>,
        eax: u32,
        ebx: u32,
        ecx: u32,
        edx: u32,
    }

    enum reg {
        rax,
        rbx,
        rcx,
        rdx,
        rsi,
        rdi,
        rsp,
        rbp,
        r8,
        r9,
        r10,
        r11,
        r12,
        r13,
        r14,
        r15,
        rip,
        rflags,
    }

    enum s-reg {
        cr0,
        cr2,
        cr3,
        cr4,
        cr8,
        efer,
        apic-base,
    }

    enum seg-reg {
        cs,
        ds,
        es,
        fs,
        gs,
        ss,
        tr,
        ldtr,
    }

    enum dt-reg {
        gdtr,
        idtr,
    }

    record seg-reg-val {
        selector: u16,
        base: u64,
        limit: u32,
        access: u32,
    }

    record dt-reg-val {
        base: u64,
        limit: u16,
    }

    record mem-map-option {
        read: bool,
        write: bool,
        exec: bool,
        log-dirty: bool,
    }

    record io-exit {
        port: u16,
        write: option<u32>,
        size: u8,
    }

    record mmio-exit {
        addr: u64,
        write: option<u64>,
        size: u8,
    }

    variant vm-exit {
        io(io-exit),
        mmio(mmio-exit),
        shutdown,
        reboot,
        unknown(string),
        interrupted,
    }

    variant vm-entry {
        none,
        shutdown,
        reboot,
        io(u32),
        mmio(u64),
    }

    record poll-event {
        token: u64,
        is-readable: bool,
        is-writable: bool,
    }

    record vcpu-exit {
        id: u32,
        exit: vm-exit,
    }

    variant vm-event {
        vcpu-exit(vcpu-exit),
        serial-input,
        poll(poll-event),
    }

    variant io-error {
        would-block,
        interrupted,
        other(string),
    }

    resource mem-pages {
        addr: func() -> u64;
        size: func() -> u64;
        sync: func() -> result<_, string>;
        read: func(offset: u64, len: u64) -> result<list<u8>, string>;
        write: func(offset: u64, src: list<u8>) -> result<_, string>;
    }

    resource vm-memory {
        mem-map: func(slot: u32, gpa: u64, size: u64, hva: u64, opt: mem-map-option) -> result<_, string>;
        unmap: func(slot: u32, gpa: u64, size: u64) -> result<_, string>;
        max-mem-slots: func() -> result<u32, string>;
        register-encrypted-range: func(addr: u64, size: u64) -> result<_, string>;
        deregister-encrypted-range: func(addr: u64, size: u64) -> result<_, string>;
        alloc-anon-mem: func(size: u64) -> result<mem-pages, string>;
    }

    resource intx-sender {
        send: func() -> result<_, string>;
    }

    resource msi-sender {
        send: func(addr: u64, data: u32) -> result<_, string>;
    }

    resource serial-console {
        write-byte: func(byte: u8) -> result<_, string>;
        read-input: func() -> result<option<list<u8>>, string>;
        shutdown: func() -> result<_, string>;
    }

    resource tap {
        detected-offload: func() -> u64;
        enable-offload: func(feature: u64) -> result<_, string>;
        register: func(token: u64, interests: u8) -> result<_, string>;
        deregister: func();
        read: func(max-len: u64) -> result<list<u8>, io-error>;
        write: func(data: list<u8>) -> result<u64, io-error>;
    }

    resource vcpu {
        get-reg: func(r: reg) -> result<u64, string>;
        set-regs: func(vals: list<tuple<reg, u64>>) -> result<_, string>;
        get-seg-reg: func(r: seg-reg) -> result<seg-reg-val, string>;
        get-dt-reg: func(r: dt-reg) -> result<dt-reg-val, string>;
        get-sreg: func(r: s-reg) -> result<u64, string>;
        set-sregs: func(
            sregs: list<tuple<s-reg, u64>>,
            seg-regs: list<tuple<seg-reg, seg-reg-val>>,
            dt-regs: list<tuple<dt-reg, dt-reg-val>>,
        ) -> result<_, string>;
        set-cpuids: func(cpuids: list<cpuid>) -> result<_, string>;
        dump: func() -> result<_, string>;
    }

    resource vm {
        create-vcpu: func(id: u32) -> result<vcpu, string>;
        stop-vcpu: func(id: u32) -> result<_, string>;
        resume-vcpu: func(id: u32, entry: vm-entry) -> result<_, string>;
        next-event: func() -> result<vm-event, string>;
        create-vm-memory: func() -> result<vm-memory, string>;
        create-intx-sender: func(pin: u8) -> result<intx-sender, string>;
        create-msi-sender: func() -> result<msi-sender, string>;
        create-serial-console: func() -> result<serial-console, string>;
        create-tap: func(if-name: option<string>) -> result<tap, string>;
    }

    resource hypervisor {
        create-vm: func() -> result<vm, string>;
        get-supported-cpuids: func() -> result<list<cpuid>, string>;
    }

    get-hypervisor: func() -> result<hypervisor, string>;
}

world vmm-world {
    import api;
    export run: func(config-path: string) -> result<_, string>;
}
