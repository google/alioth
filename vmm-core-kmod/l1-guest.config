# Minimal fast-building L1 Linux guest config fragment merged onto
# `x86_64_defconfig` + `kvm_guest.config` (`make O=target/linux-kbuild`).
# Leaves `../linux-stable` 100% untouched and supports:
#  - Loadable out-of-tree `airlock.ko` (without module signing keys)
#  - Optional `kvm.ko` + `kvm-amd.ko` (`=m`) to test both `!kvm` and KVM coexistence
#  - Built-in `virtio-iommu` + ACPI `VIOT` + `pci-stub` for IOMMU device passthrough
#  - Built-in `virtio-blk`, `virtio-net`, `ext4`, `initramfs`, `tun`, `bridge`, `seccomp`

# Core module & hardening settings
CONFIG_WERROR=n
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_SIG is not set
# CONFIG_MODVERSIONS is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set

# Guest paravirt, entropy, & THP
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_RANDOM_TRUST_CPU=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y

# IOMMU (`virtio-iommu` + ACPI `VIOT`) & PCI passthrough support
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_STUB=y
CONFIG_IOMMU_API=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_VIRTIO_IOMMU=y
CONFIG_ACPI_VIOT=y

# VirtIO, block, filesystems, console, & networking
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_TUN=y
CONFIG_BRIDGE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Optional KVM as loadable modules (`=m`) so tests verify BOTH:
#   (a) `kvm` & `kvm-amd` NOT loaded (default boot)
#   (b) `kvm` & `kvm-amd` loaded alongside `airlock.ko`
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=m
CONFIG_KVM_AMD=m
# CONFIG_KVM_INTEL is not set

# Trim unneeded physical hardware subsystems for fast (~15s) builds & sub-second boot
# CONFIG_DRM is not set
# CONFIG_AGP is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_RFKILL is not set
# CONFIG_PCCARD is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_MD is not set
# CONFIG_NFS_FS is not set
# CONFIG_9P_FS is not set
# CONFIG_NET_9P is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_MACINTOSH_DRIVERS is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_EFI is not set
# CONFIG_X86_PLATFORM_DEVICES is not set
# CONFIG_ETHERNET is not set
# CONFIG_SECURITY_SELINUX is not set
